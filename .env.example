# 多账号 Cookie：建议使用换行分隔（也支持逗号分隔）
FF14RS_COOKIES="userinfo=...; ff14risingstones=...; ...\nuserinfo=...; ff14risingstones=...; ..."

# 盛趣游戏商城（qu.sdo.com）多账号 Cookie：建议换行分隔（可选）
FF14RS_QU_COOKIES=""

# 盛趣游戏商城 merchantId（默认 1）
FF14RS_QU_MERCHANT_ID=1

# 推送通知 URL（statocysts），多个用逗号分隔
FF14RS_NOTIFICATION_URLS=""

# 最大重试次数（默认 3）
FF14RS_MAX_RETRIES=3

# 是否自动领取当月档位奖励（默认 true）
FF14RS_AUTO_CLAIM=true

# 单次 HTTP 请求超时（毫秒，默认 20000）
FF14RS_REQUEST_TIMEOUT_MS=20000

# 任意账号失败时是否让进程退出非 0（默认 true）
FF14RS_FAIL_ON_ERROR=true
